# Used by `npm run dev` (Node) and `npm run db:migrate`.
# Without DATABASE_URL the dev server uses a temporary in-memory database.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
ALLOWED_ORIGINS=http://localhost:5173
